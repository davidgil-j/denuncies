# ── Supabase (requerit) ────────────────────────────────────────────
VITE_SUPABASE_URL=https://TU_PROJECTE.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...  # Project Settings > API > anon key

# ── Cloudflare Turnstile (antibot, requerit) ───────────────────────
VITE_TURNSTILE_SITE_KEY=       # dash.cloudflare.com > Turnstile > Add site key

# ── Sentry (monitoratge d'errors, opcional però recomanat) ────────
VITE_SENTRY_DSN=https://...@sentry.io/...  # sentry.io > Project > Settings > DSN

# ── Email (opcional) ───────────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=       # emailjs.com > Email Services
VITE_EMAILJS_TEMPLATE_ID=      # emailjs.com > Email Templates
VITE_EMAILJS_PUBLIC_KEY=       # emailjs.com > Account > Public Key

# ── Credentials locals per migracions (NO pujar a git) ────────────
# Crear un fitxer .env.local amb:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Project Settings > API > service_role key
# SUPABASE_PAT=sbp_...              # supabase.com > Account > Access Tokens

# Adreça pública del lloc (per als enllaços, el QR i el cartell del canal). Opcional: si falta, s'usa la del navegador
VITE_PUBLIC_ORIGIN=            # https://el-vostre-domini.es

# Mode demostració sense base de dades (dades inventades). NOMÉS per ensenyar la web: mai en producció
VITE_DEMO=                     # 1 per activar-lo en un build sense credencials

# Edge functions (Supabase > Edge Functions > Secrets), no al frontend:
#   SITE_URL=https://el-vostre-domini.es   (obligatori per a invite-manager: l'enllaç de la invitació)
