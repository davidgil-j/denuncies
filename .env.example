# ── Supabase (obligatorio en producción) ───────────────────────────
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...  # Project Settings > API > anon key
# Sin estas dos variables la aplicación arranca en modo demo (solo en desarrollo, o con VITE_DEMO=1).

# ── Dirección pública del sitio (opcional) ─────────────────────────
# Para los enlaces, el QR y el cartel del canal, y para la vista previa al compartir el enlace.
# Si falta, el QR y los enlaces usan la del navegador y la vista previa, https://reportia-canal.vercel.app
VITE_PUBLIC_ORIGIN=            # https://vuestro-dominio.es

# ── Cloudflare Turnstile (antispam, opcional) ──────────────────────
# Con la clave puesta se pide en el formulario de denuncia y en el acceso al panel.
VITE_TURNSTILE_SITE_KEY=       # dash.cloudflare.com > Turnstile > Add site key

# ── Adjuntos ───────────────────────────────────────────────────────
# Tamaño máximo de cada archivo adjunto, en MB (por defecto 50, el límite del plan gratuito de Supabase).
# Subir a 500 cuando se pase a Supabase Pro y se cambie el límite del bucket
VITE_MAX_FILE_MB=50

# ── Sentry (aviso de errores, opcional) ────────────────────────────
# Solo en el panel y en la web: nunca se carga en el canal de denuncias.
VITE_SENTRY_DSN=               # sentry.io > Project > Settings > DSN

# ── Modo demostración ──────────────────────────────────────────────
# Sin base de datos, con datos inventados. SOLO para enseñar la web: nunca en producción
VITE_DEMO=                     # 1 para activarlo en un build sin credenciales

# ── Ayudas de IA del panel (apagadas por defecto) ──────────────────
# 1 las enciende. Antes hay que elegir proveedor y firmar su contrato: ver docs/IA.md
VITE_AI_ENABLED=

# ── Credenciales locales para las migraciones (NO subir a git) ─────
# En un archivo .env.local:
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  # Project Settings > API > service_role key
# SUPABASE_PAT=sbp_...              # supabase.com > Account > Access Tokens

# ── Funciones de servidor (Supabase > Edge Functions > Secrets), no en el frontend ──
#   invite-manager:  SITE_URL=https://vuestro-dominio.es   (obligatorio: el enlace de la invitación)
#   notify:          RESEND_API_KEY, MAIL_FROM, SITE_URL, WEBHOOK_SECRET
#   ai-assist:       AI_PROVIDER_URL, AI_API_KEY, AI_MODEL, AI_PROVIDER_FORMAT   (no desplegada)
